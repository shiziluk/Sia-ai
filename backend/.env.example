# ===== 希亚后端环境配置模板：复制为 .env 后填写（.env 不进 Git）=====

# ---- LLM 在线通道（阿里云 dashscope，V13 同款）----
# 注意：V13 源码中硬编码的旧 key 已泄漏，建议作废重发后填到这里
DASHSCOPE_API_KEY=sk-xxxxxxxx
QWEN_MODEL=qwen-plus
QWEN_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# ---- LLM 本地通道（Ollama，主力通道）----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# 通道策略：auto=本地优先失败切在线 | local=仅本地 | online=仅在线
LLM_CHANNEL=auto
# 本地通道超时秒数（超时视为不可用，切在线）
LLM_LOCAL_TIMEOUT=60

# ---- 和风天气（V13 同款：雷雨关怀联动）----
WEATHER_API_KEY=xxxxxxxx
WEATHER_HOST=kt564v8p3t.re.qweatherapi.com
WEATHER_CITY_ID=101210701

# ---- 数据 ----
# SQLite 数据库与 chroma 记忆库所在目录（相对 backend\ 或绝对路径）
DATA_DIR=./data

# ---- 语音 ----
TTS_VOICE=zh-CN-XiaoyiNeural
VOSK_MODEL_PATH=./models/vosk-model-cn-0.22
FFMPEG_PATH=ffmpeg

# ---- 用户资料 ----
USER_NAME=小叶
USER_BIRTHDAY=04-06

# ---- 服务 ----
API_HOST=127.0.0.1
API_PORT=8900
# 前端开发服务器来源（CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
