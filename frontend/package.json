{
  "name": "xia-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "希亚 - 我的AI女友 前端（Vue3 + Vite + TS + Pinia + PWA）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.0.0"
  }
}
